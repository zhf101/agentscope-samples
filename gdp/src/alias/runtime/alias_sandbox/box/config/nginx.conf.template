worker_processes 1;

events { worker_connections 1024; }

http {
    # Long-running tool calls and streaming responses can be slow.
    proxy_connect_timeout 120s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    server {
        listen 80;

        # FastAPI backend. `/fastapi` prefix is stripped before proxying.
        location /fastapi {
            rewrite ^/fastapi(.*)$ $1 break;
            proxy_pass http://localhost:8000;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # Static noVNC web assets.
        location /vnc/ {
            alias /usr/share/novnc/;
            index vnc.html;

            include /etc/nginx/mime.types;

            types {
                application/javascript js;
            }
        }

        # WebSocket tunnel from browser client -> local websockify process.
        location /websockify {
            proxy_pass http://localhost:9000/websockify;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
